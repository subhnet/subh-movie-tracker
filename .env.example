# Supabase Configuration (Database)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Authentication
# Run `openssl rand -base64 32` to generate a secure secret
JWT_SECRET=your_jwt_secret_min_32_chars

# Movie APIs (Required for details and streaming availability)
# Get a key at https://www.themoviedb.org/documentation/api
TMDB_API_KEY=your_tmdb_api_key
# Get a key at http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Registration Code
REGISTRATION_ACCESS_CODE=your_registration_access_code_here

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Trakt backup (scraper/trakt-backup.js). The Trakt profile must be public.
# Get a client id at https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_USERNAME=your_trakt_username
# Timezone used for watched dates (default Asia/Kolkata)
TRAKT_TIMEZONE=Asia/Kolkata

# AI Configuration
# Options: 'gemini', 'openrouter', 'cerebras'
AI_PROVIDER=gemini

# Google Gemini API
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Cerebras API
# Get key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=csk-hm4n36kwjvmy8f6nx6pp43p3fjrj2r3t63eynfmecrvttxck
